    app_commands.Choice(name="1 │ Trainee", value="1 │ Trainee"),
    app_commands.Choice(name="2 │ Patrol", value="2 │ Patrol"),
    app_commands.Choice(name="3 │ Welder", value="3 │ Welder"),
